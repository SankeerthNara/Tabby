# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default. Switch to https://api-m.paypal.com only for live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional fallback when every Gemini model is busy/out of quota: Cloudflare Workers AI
# (free daily allowance, no card). dash.cloudflare.com -> AI -> Workers AI -> Use REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Log in with PayPal sessions: any random string of 32+ characters
SESSION_SECRET=
# Saved splits for "My tabs" (free Upstash Redis: console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# "Try the demo" button for hackathon judges (shared demo account, no PayPal login). Set to 1 to enable.
NEXT_PUBLIC_DEMO_LOGIN=
# Optional: demo account's display name and email (use a sandbox personal account email to receive splits)
DEMO_NAME=
DEMO_EMAIL=
# Forward friends' payments to whoever paid the bill with PayPal Payouts. Set to 1 to enable.
# Needs a sandbox business account in a country that can send Payouts (e.g. US; India accounts can't).
PAYPAL_PAYOUTS=
