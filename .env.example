# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default. Switch to https://api-m.paypal.com only for live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional fallback when every Gemini model is busy/out of quota: Cloudflare Workers AI
# (free daily allowance, no card). dash.cloudflare.com -> AI -> Workers AI -> Use REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
